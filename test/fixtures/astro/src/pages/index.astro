---
const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true })) as {
  url: string;
  frontmatter: { title: string };
}[];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Fixture home</title>
  </head>
  <body>
    <main>
      <h1>Fixture home</h1>
      <ul>{posts.map((post) => <li><a href={`${post.url}/`}>{post.frontmatter.title}</a></li>)}</ul>
    </main>
  </body>
</html>
